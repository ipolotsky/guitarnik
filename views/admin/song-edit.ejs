<%- include('../partials/header', { title: title, active: 'admin' }) %>
<% const gearList = song.gear == null ? [] : String(song.gear).split(',').map(x => x.trim()); -%>
<% const performerList = song.performers == null ? [] : String(song.performers).split(',').map(x => x.trim()); -%>
<% const isOn = value => value === true || value === 'TRUE' || value === '1' || value === 'on'; -%>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <h1 class="h2 mb-0">Правка песни</h1>
  <a class="btn btn-outline-secondary btn-sm" href="/admin?tab=songs">К списку песен</a>
</div>

<% if (error != null) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<form method="post" action="/admin/songs/<%= song.id %>/edit">
  <div class="row g-3 mb-3">
    <div class="col-12 col-md-6">
      <label class="form-label fw-semibold" for="title">Название</label>
      <input class="form-control" type="text" id="title" name="title" value="<%= song.title %>" required>
    </div>
    <div class="col-12 col-md-6">
      <label class="form-label" for="original_artist">Автор оригинала</label>
      <input class="form-control" type="text" id="original_artist" name="original_artist" value="<%= song.original_artist %>">
    </div>
    <div class="col-12 col-md-4">
      <label class="form-label" for="type">Тип</label>
      <select class="form-select" id="type" name="type">
        <option value="perform"<%= song.type === 'perform' ? ' selected' : '' %>>играет сам</option>
        <option value="wish"<%= song.type === 'wish' ? ' selected' : '' %>>хотелка</option>
      </select>
    </div>
    <div class="col-12 col-md-4">
      <label class="form-label" for="status">Статус</label>
      <select class="form-select" id="status" name="status">
        <% reference.STATUSES.forEach(x => { %>
          <option value="<%= x %>"<%= song.status === x ? ' selected' : '' %>><%= x %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-12 col-md-4">
      <label class="form-label" for="added_by">Кто добавил</label>
      <select class="form-select" id="added_by" name="added_by">
        <option value="">никто, аноним</option>
        <% participants.forEach(x => { %>
          <option value="<%= x.id %>"<%= song.added_by === x.id ? ' selected' : '' %>><%= x.name %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <div class="mb-3">
    <span class="form-label fw-semibold">Исполнители</span>
    <div class="border rounded p-2 picker-list">
      <% participants.forEach(x => { %>
        <div class="form-check py-1">
          <input class="form-check-input" type="checkbox" name="performers" value="<%= x.id %>" id="performer-<%= x.id %>"<%= performerList.indexOf(x.id) === -1 ? '' : ' checked' %>>
          <label class="form-check-label w-100" for="performer-<%= x.id %>">
            <%= x.name %><% if (x.instruments) { %> <span class="text-body-secondary">— <%= x.instruments %></span><% } %>
          </label>
        </div>
      <% }) %>
      <% if (participants.length === 0) { %>
        <div class="text-body-secondary small">Участников пока нет</div>
      <% } %>
    </div>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-12 col-sm-8">
      <label class="form-label" for="who_plays_what">Кто на чем играет и кто поет</label>
      <textarea class="form-control" id="who_plays_what" name="who_plays_what" rows="2"><%= song.who_plays_what %></textarea>
    </div>
    <div class="col-12 col-sm-4">
      <label class="form-label" for="tonality">Тональность</label>
      <input class="form-control" type="text" id="tonality" name="tonality" value="<%= song.tonality %>">
    </div>
  </div>

  <div class="mb-3">
    <label class="form-label" for="need_musicians">Нужны еще музыканты</label>
    <input class="form-control" type="text" id="need_musicians" name="need_musicians" value="<%= song.need_musicians %>">
  </div>

  <div class="mb-3">
    <span class="form-label fw-semibold">Оборудование площадки</span>
    <div class="d-flex flex-wrap gap-2">
      <% reference.GEAR.forEach((x, i) => { %>
        <input class="btn-check" type="checkbox" name="gear" value="<%= x %>" id="edit-gear-<%= i %>" autocomplete="off"<%= gearList.indexOf(x) === -1 ? '' : ' checked' %>>
        <label class="btn btn-outline-primary btn-sm" for="edit-gear-<%= i %>"><%= x %></label>
      <% }) %>
    </div>
  </div>

  <div class="mb-3">
    <label class="form-label" for="own_gear">Приду со своим</label>
    <input class="form-control" type="text" id="own_gear" name="own_gear" value="<%= song.own_gear %>">
  </div>

  <div class="mb-3">
    <div class="form-check">
      <input class="form-check-input" type="checkbox" name="need_prompter" value="1" id="need_prompter"<%= isOn(song.need_prompter) || song.needPrompter === true ? ' checked' : '' %>>
      <label class="form-check-label" for="need_prompter">Нужен суфлёр</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" name="show_on_projector" value="1" id="show_on_projector"<%= isOn(song.show_on_projector) || song.showOnProjector === true ? ' checked' : '' %>>
      <label class="form-check-label" for="show_on_projector">Показывать текст на проекторе</label>
    </div>
  </div>

  <div class="mb-3">
    <label class="form-label" for="lyrics">Текст песни</label>
    <textarea class="form-control" id="lyrics" name="lyrics" rows="8"><%= song.lyrics %></textarea>
  </div>

  <div class="mb-3">
    <label class="form-label" for="lyrics_url">Ссылка на текст</label>
    <input class="form-control" type="text" id="lyrics_url" name="lyrics_url" value="<%= song.lyrics_url %>">
  </div>

  <div class="mb-4">
    <label class="form-label" for="note">Комментарий</label>
    <textarea class="form-control" id="note" name="note" rows="2"><%= song.note %></textarea>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <button class="btn btn-primary" type="submit">Сохранить</button>
    <a class="btn btn-outline-secondary" href="/admin?tab=songs">Отмена</a>
    <a class="btn btn-outline-secondary ms-auto" href="/songs/<%= song.id %>">Открыть на сайте</a>
  </div>
</form>

<%- include('../partials/footer') %>

<% const partnerValues = locals.values == null ? {} : locals.values; -%>
<% const selectedPartners = partnerValues.partners == null ? [] : [].concat(partnerValues.partners); -%>
<% const partnerGroups = [{ label: 'Готовы подыграть', people: readyPartners }, { label: 'Остальные', people: otherPartners }]; -%>
<div class="mb-3" data-picker>
  <span class="form-label fw-semibold">С кем играешь</span>
  <div class="form-text mb-2">Отметь всех, кто выйдет с тобой. Можно никого</div>
  <div class="d-flex flex-wrap gap-2 mb-2" data-picker-chips hidden></div>
  <input class="form-control mb-2" type="search" placeholder="Найти по имени или инструменту" aria-label="Поиск по участникам" data-picker-search>
  <div class="border rounded p-2 picker-list" data-picker-list>
    <% partnerGroups.forEach(group => { %>
      <% if (group.people.length > 0) { %>
        <div class="fw-semibold small text-body-secondary px-1 py-1" data-picker-group><%= group.label %></div>
        <% group.people.forEach(x => { %>
          <div class="form-check py-1" data-picker-option data-search="<%= (x.name + ' ' + x.instruments).toLowerCase() %>">
            <input class="form-check-input" type="checkbox" name="partners" value="<%= x.id %>" id="partner-<%= x.id %>"<%= selectedPartners.indexOf(x.id) === -1 ? '' : ' checked' %> data-name="<%= x.name %>">
            <label class="form-check-label w-100" for="partner-<%= x.id %>">
              <%= x.name %><% if (x.instruments) { %> <span class="text-body-secondary">— <%= x.instruments %></span><% } %>
            </label>
          </div>
        <% }) %>
      <% } %>
    <% }) %>
    <div class="text-body-secondary small px-1 py-2" data-picker-empty hidden>Никого не нашлось</div>
  </div>
</div>
<div class="mb-3">
  <span class="form-label">Кого-то нет в списке</span>
  <div data-partners>
    <div class="row g-2 mb-2">
      <div class="col-12 col-sm-6">
        <input class="form-control" type="text" name="partner_name" placeholder="Имя" aria-label="Имя нового человека">
      </div>
      <div class="col-12 col-sm-6">
        <input class="form-control" type="text" name="partner_instruments" placeholder="Инструменты через запятую" aria-label="Инструменты нового человека">
      </div>
    </div>
  </div>
  <button class="btn btn-outline-secondary btn-sm" type="button" data-partners-add>Еще человек</button>
</div>

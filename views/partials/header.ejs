<% const activeItem = locals.active == null ? '' : locals.active; -%>
<!doctype html>
<html lang="ru" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> - <%= reference.SITE_NAME %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/app.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23151110'/%3E%3Ccircle cx='12' cy='22' r='4.5' fill='%23ff6b3d'/%3E%3Crect x='15' y='6' width='2.6' height='16' fill='%23ff6b3d'/%3E%3Cpath d='M17.6 6c4.4 1.1 6.8 2.6 6.8 5.6-1.3-2.2-3.6-3.4-6.8-3.6z' fill='%23ff6b3d'/%3E%3C/svg%3E">
</head>
<body>
  <nav class="navbar navbar-expand-sm bg-body-tertiary border-bottom">
    <div class="container">
      <a class="navbar-brand" href="/"><%= reference.SITE_NAME %></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav" aria-controls="main-nav" aria-expanded="false" aria-label="Меню">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="main-nav">
        <ul class="navbar-nav">
          <li class="nav-item"><a class="nav-link<%= activeItem === 'home' ? ' active' : '' %>" href="/">Главная</a></li>
          <li class="nav-item"><a class="nav-link<%= activeItem === 'songs' ? ' active' : '' %>" href="/songs">Песни</a></li>
          <li class="nav-item"><a class="nav-link<%= activeItem === 'lineup' ? ' active' : '' %>" href="/lineup">Лайнап</a></li>
          <li class="nav-item"><a class="nav-link<%= activeItem === 'helpers' ? ' active' : '' %>" href="/helpers">Музыканты</a></li>
          <li class="nav-item"><a class="nav-link<%= activeItem === 'add' ? ' active' : '' %>" href="/add">Добавить</a></li>
          <% if (locals.isAdmin) { %>
            <li class="nav-item"><a class="nav-link<%= activeItem === 'admin' ? ' active' : '' %>" href="/admin">Админка</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>
  <main class="container py-4">

<%- include('partials/header', { title: 'Заказать песню', active: 'add' }) %>

<h1 class="mb-4">Заказать песню</h1>

<% if (error != null) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<% if (locals.twin != null) { %>
  <div class="alert alert-warning">
    <p class="mb-2">Такую песню уже заказывали или ее уже играют: <a href="/songs/<%= twin.id %>"><%= twin.title %></a><% if (twin.originalArtist) { %> — <%= twin.originalArtist %><% } %>.</p>
    <p class="mb-0">Лучше открыть ее и поставить лайк, так она поднимется выше. Если это другая песня с тем же названием, нажми «Все равно заказать».</p>
  </div>
<% } %>

<form method="post" action="/add/wish">
  <% if (locals.twin != null) { %>
    <input type="hidden" name="confirm" value="1">
  <% } %>
  <div class="mb-4">
    <label class="form-label fw-semibold" for="title">Название песни</label>
    <input class="form-control form-control-lg" type="text" id="title" name="title" value="<%= values.title == null ? '' : values.title %>" required>
  </div>

  <details class="border rounded p-3 mb-4"<%= submitted ? ' open' : '' %>>
    <summary class="fw-semibold">Еще детали <span class="fw-normal text-body-secondary">— автор, текст, кто заказывает</span></summary>
    <div class="pt-3">
      <div class="mb-4">
        <div class="form-text mb-2">По умолчанию заказ анонимный. Если хочешь, отметься, тогда в списке будет видно, чья это хотелка</div>
        <%- include('partials/who', { whoOptional: true }) %>
      </div>

      <div class="mb-3">
        <label class="form-label" for="original_artist">Автор оригинала</label>
        <input class="form-control" type="text" id="original_artist" name="original_artist" value="<%= values.original_artist == null ? '' : values.original_artist %>">
      </div>

      <div class="mb-3">
        <label class="form-label" for="lyrics">Текст песни</label>
        <textarea class="form-control" id="lyrics" name="lyrics" rows="6"><%= values.lyrics == null ? '' : values.lyrics %></textarea>
        <div class="form-text">если знаешь, где взять текст — вставь, это сэкономит время тому, кто возьмётся</div>
        <%- include('partials/lyrics-hint') %>
      </div>

      <div class="mb-3">
        <label class="form-label" for="lyrics_url">Ссылка на текст</label>
        <input class="form-control" type="text" id="lyrics_url" name="lyrics_url" value="<%= values.lyrics_url == null ? '' : values.lyrics_url %>">
      </div>

      <div class="mb-0">
        <label class="form-label" for="note">Почему хочешь именно её</label>
        <textarea class="form-control" id="note" name="note" rows="3"><%= values.note == null ? '' : values.note %></textarea>
        <div class="form-text">пара слов помогает кому-то решиться её взять</div>
      </div>
    </div>
  </details>

  <div class="d-grid gap-2 d-sm-flex">
    <button class="btn btn-primary btn-lg" type="submit"><%= locals.twin != null ? 'Все равно заказать' : 'Заказать песню' %></button>
  </div>
</form>

<%- include('partials/footer') %>
